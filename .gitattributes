# Normalize all text files to LF in the repository.
* text=auto eol=lf

*.md   text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cff  text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary

# Generated artifacts: keep them in the repo (the offline panel depends on
# index.html) but collapse their diffs and exclude them from language stats.
index.html          linguist-generated=true
data/bundle.json    linguist-generated=true
